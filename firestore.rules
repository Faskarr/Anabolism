rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════
//  AnabolicOS — règles de sécurité Firestore
//
//  Principes :
//   • Chaque utilisateur ne voit et ne modifie QUE ses propres données.
//   • L'admin (document admins/{uid} créé à la main dans la console) peut tout
//     lire et tout modifier, sauf la liste des admins elle-même.
//   • Un compte désactivé (users/{uid}.status == 'disabled') ne peut plus
//     écrire. Rien n'est supprimé.
//   • Tout ce qui n'est pas explicitement autorisé est refusé.
//
//  Coût : chaque get()/exists() évalué est facturé comme une lecture. Les
//  conditions gratuites (propriétaire, forme des données) sont donc placées
//  AVANT les conditions qui lisent un document (ami, admin, compte actif) :
//  l'évaluation s'arrête dès que le résultat est connu.
//
//  Syntaxe : un test de type (`x is int`) est toujours suivi de `&&` ou d'un
//  retour à la ligne + `&&`, jamais directement d'une parenthèse ou d'un `;`.
// ═══════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isActive(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.status == 'active';
    }
    function ownerActive(uid) {
      return isOwner(uid) && isActive(uid);
    }
    // Vrai si la mise à jour ne touche QUE les champs listés.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isShortString(v, max) {
      return v is string && v.size() <= max;
    }
    // Horodatage client en ms, au plus 1 jour dans le futur (horloge du téléphone).
    function notFuture(t) {
      return t is int && t <= request.time.toMillis() + 86400000;
    }
    // Identifiant d'amitié : les deux uid triés, joints par « _ ».
    function pairOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    // Ami = amitié ACCEPTÉE (une demande en attente ne donne accès à rien).
    // Les amitiés créées avant les demandes (sans statut) comptent comme acceptées.
    function isFriend(uid) {
      return signedIn()
        && get(/databases/$(database)/documents/friendships/$(pairOf(request.auth.uid, uid))).data.get('status', 'accepted') == 'accepted';
    }
    function friendshipAccepted(pid) {
      return get(/databases/$(database)/documents/friendships/$(pid)).data.get('status', 'accepted') == 'accepted';
    }
    function isMessage(data, sender) {
      return data.keys().hasOnly(['from', 'text', 'at'])
        && data.from == sender
        && isShortString(data.text, 2000)
        && data.text.size() > 0
        && data.at == request.time;
    }
    // Envoi d'un programme / diet / protocole à un ami (contenu en JSON, taille bornée).
    function isShareMessage(data, sender) {
      return data.keys().hasOnly(['from', 'text', 'at', 'kind', 'cat', 'title', 'payload', 'status'])
        && data.from == sender
        && data.kind == 'share'
        && data.cat in ['workout', 'diet', 'protocol']
        && isShortString(data.title, 80)
        && isShortString(data.text, 200)
        && data.payload is string
        && data.payload.size() <= 300000
        && data.status == 'pending'
        && data.at == request.time;
    }
    function musicUrlOk(u) {
      return isShortString(u, 300)
        && u.matches('^https://(open[.]spotify[.]com|spotify[.]link|(www[.])?deezer[.]com|deezer[.]page[.]link|link[.]deezer[.]com|music[.]apple[.]com|music[.]youtube[.]com)/[^ ]*$');
    }
    // Profil racine : nom court, photo Google uniquement (pas de pixel espion).
    function isProfileOk(d) {
      return isShortString(d.get('displayName', ''), 120)
        && isShortString(d.get('photoURL', ''), 500)
        && d.get('photoURL', '').matches('^(https://[a-z0-9.-]+[.]googleusercontent[.]com/[^ ]*)?$');
    }
    // Publication « record » partagée avec les amis.
    function isPrPost(d) {
      return d.type == 'pr'
        && d.w is number
        && d.r is int
        && d.get('e1rm', 0) is number
        && d.keys().hasOnly(['type', 'name', 'exercise', 'w', 'r', 'e1rm', 'at', 'likes'])
        && isShortString(d.exercise, 120);
    }
    // Publication « musique » : lien https vers Spotify / Deezer / Apple Music / YouTube Music.
    // (« service » est un mot réservé des règles → accès par d['service'])
    function isMusicPost(d) {
      return d.type == 'music'
        && d.keys().hasOnly(['type', 'name', 'url', 'title', 'service', 'at', 'likes'])
        && d['service'] in ['spotify', 'deezer', 'apple', 'youtube']
        && isShortString(d.title, 120)
        && musicUrlOk(d.url);
    }
    // Copie de la dernière publication dans activity/{uid} (vide autorisé).
    function isPostCopy(m) {
      return m is map
        && (m.size() == 0 || (
          isShortString(m.get('id', ''), 40) && (
            (m.get('type', '') == 'music'
              && m.keys().hasOnly(['id', 'type', 'url', 'title', 'service', 'at'])
              && m['service'] in ['spotify', 'deezer', 'apple', 'youtube']
              && isShortString(m.get('title', ''), 120)
              && musicUrlOk(m.url)
              && notFuture(m.at))
            || (m.get('type', '') == 'pr'
              && m.w is number
              && m.r is int
              && m.get('e1rm', 0) is number
              && m.keys().hasOnly(['id', 'type', 'exercise', 'w', 'r', 'e1rm', 'at'])
              && isShortString(m.exercise, 120)
              && notFuture(m.at)))));
    }
    // Activité visible par les amis (+ dernière publication et version de la photo).
    function isActivity(d) {
      return d.get('avatarAt', 0) is int
        && d.get('at', request.time) is timestamp
        && d.keys().hasOnly(['name', 'day', 'sessionName', 'at', 'lastPost', 'lastMusic', 'avatarAt'])
        && isShortString(d.get('name', ''), 120)
        && (d.get('day', null) == null || isShortString(d.get('day', ''), 10))
        && (d.get('sessionName', null) == null || isShortString(d.get('sessionName', ''), 60))
        && isPostCopy(d.get('lastPost', {}))
        && isPostCopy(d.get('lastMusic', {}));
    }
    // Profil visible par les amis : seules les sections que l'utilisateur partage
    // sont écrites. (Tests « is type » suivis de && : contrainte du compilateur.)
    function isSharedProfile(d) {
      return d.get('share', {}) is map
        && d.get('sessions', 0) is int
        && d.get('weight', {}) is map
        && d.get('workout', {}) is map
        && d.get('diet', {}) is map
        && d.get('protocol', {}) is map
        && d.get('updatedAt', request.time) is timestamp
        && d.keys().hasOnly(['name', 'note', 'share', 'sessions', 'weight', 'workout', 'diet', 'protocol', 'updatedAt'])
        && isShortString(d.get('name', ''), 120)
        && isShortString(d.get('note', ''), 200);
    }
    // Conversation avec le coach, écrite par l'utilisateur.
    function isUserConv(d) {
      return d.lastFrom == 'user'
        && d.status == 'open'
        && d.lastAt == request.time
        && isShortString(d.userName, 120)
        && isShortString(d.lastText, 140);
    }

    // ── Sauvegarde admin (bouton « Sauvegarder la base ») ─────────────────
    // Lecture seule des sous-collections via collectionGroup. Les règles
    // s'additionnent : rien n'est ouvert à un non-admin.
    match /{path=**}/data/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/weeks/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/inbox/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/messages/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/posts/{docId} {
      allow read: if isAdmin();
    }

    // ── Admins (lecture de son propre statut uniquement) ────────────────
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── Profil racine de l'utilisateur ──────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Création au premier login : champs imposés, statut forcé à 'active'.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'createdAt', 'lastActiveAt', 'status'])
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && isProfileOk(request.resource.data);

      // L'utilisateur ne peut jamais toucher à son statut. L'admin peut tout.
      allow update: if (isOwner(uid)
             && resource.data.status == 'active'
             && onlyChanges(['displayName', 'photoURL', 'lastActiveAt', 'lastWeight', 'lastWeightAt', 'friendCode', 'avatarAt', 'pseudo'])
             && isProfileOk(request.resource.data)
             && isShortString(request.resource.data.get('pseudo', ''), 30))
        || isAdmin();

      allow delete: if isAdmin();

      // Données métier. Lecture de ses propres données : sans lecture supplémentaire.
      match /data/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if ownerActive(uid) || isAdmin();
      }

      // Cases cochées de la semaine.
      match /weeks/{weekId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if ownerActive(uid) || isAdmin();
      }

      // Envois de l'admin (programme, diet, protocole, note).
      match /inbox/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, delete: if isAdmin();
        allow update: if (isOwner(uid)
                           && onlyChanges(['status', 'handledAt'])
                           && request.resource.data.status in ['accepted', 'dismissed']
                           && isActive(uid))
                      || isAdmin();
      }
    }

    // ── Messagerie : une conversation par utilisateur ───────────────────
    match /conversations/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if (isOwner(uid)
            && request.resource.data.keys().hasOnly(
                 ['userName', 'lastText', 'lastFrom', 'lastAt', 'userReadAt', 'status'])
            && isUserConv(request.resource.data)
            && isActive(uid))
        || isAdmin();

      allow update: if (isOwner(uid)
             && onlyChanges(['userReadAt', 'userClearedAt'])
             && request.resource.data.userReadAt == request.time
             && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userClearedAt'])
                 || request.resource.data.userClearedAt == request.time))
        || (isOwner(uid)
             && onlyChanges(['userName', 'lastText', 'lastFrom', 'lastAt', 'userReadAt', 'status'])
             && isUserConv(request.resource.data)
             && isActive(uid))
        || isAdmin();

      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) && isMessage(request.resource.data, 'user') && isActive(uid))
          || (isMessage(request.resource.data, 'admin') && isAdmin());
        allow update, delete: if isAdmin();
      }
    }

    // ── Amis ────────────────────────────────────────────────────────────
    // Code ami : lecture unitaire seulement (impossible de lister les codes).
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && isShortString(request.resource.data.name, 120);
      allow update: if isAdmin();
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // Amitié : créée « en attente » par le demandeur, avec le code de l'autre.
    match /friendships/{pid} {
      allow read: if (signedIn() && request.auth.uid in resource.data.members) || isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'code', 'createdAt', 'status', 'requestedBy'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && pid == pairOf(request.resource.data.members[0], request.resource.data.members[1])
        && request.resource.data.names is map
        && request.resource.data.names.keys().hasOnly(request.resource.data.members)
        && isShortString(request.resource.data.names.get(request.resource.data.members[0], ''), 120)
        && isShortString(request.resource.data.names.get(request.resource.data.members[1], ''), 120)
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid != request.auth.uid
        && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.code)).data.uid in request.resource.data.members
        && isActive(request.auth.uid)
        // L'admin peut ajouter quelqu'un directement (amitié acceptée d'office).
        || isAdmin();

      allow update: if (signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && (
          // (a) acceptation : seul le DESTINATAIRE de la demande peut accepter
          (resource.data.get('status', 'accepted') == 'pending'
            && request.resource.data.status == 'accepted'
            && request.auth.uid != resource.data.requestedBy
            && onlyChanges(['status', 'acceptedAt']))
          // (b) aperçu du dernier message / lecture, une fois amis :
          //     chacun ne modifie que SA date de lecture, et l'aperçu n'est
          //     réécrit que par l'auteur du message, à l'instant de l'envoi.
          || (resource.data.get('status', 'accepted') == 'accepted'
            && onlyChanges(['lastText', 'lastFrom', 'lastAt', 'readAt', 'clearedAt'])
            && request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.get('clearedAt', {}).diff(resource.data.get('clearedAt', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText', 'lastFrom', 'lastAt'])
                || (request.resource.data.lastFrom == request.auth.uid
                    && request.resource.data.lastAt == request.time
                    && isShortString(request.resource.data.lastText, 140))))
          // (c) changement de pseudo : chacun ne modifie que SON nom affiché
          || (onlyChanges(['names'])
            && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
            && isShortString(request.resource.data.names[request.auth.uid], 120))
        )
        && isActive(request.auth.uid))
        || isAdmin();

      // Refuser / annuler / retirer un ami : l'un ou l'autre peut supprimer.
      allow delete: if (signedIn() && request.auth.uid in resource.data.members) || isAdmin();

      match /messages/{mid} {
        allow read: if (signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && friendshipAccepted(pid))
          || isAdmin();
        allow create: if signedIn()
          && (isMessage(request.resource.data, request.auth.uid)
              || isShareMessage(request.resource.data, request.auth.uid))
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members
          && friendshipAccepted(pid)
          && isActive(request.auth.uid);
        // Réponse à un envoi : seul le DESTINATAIRE, une seule fois, uniquement le statut.
        allow update: if (signedIn()
          && resource.data.get('kind', '') == 'share'
          && resource.data.status == 'pending'
          && resource.data.from != request.auth.uid
          && onlyChanges(['status'])
          && request.resource.data.status in ['accepted', 'refused']
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.members)
          || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // Activité visible par les amis (séance du jour, dernière publication, photo).
    match /activity/{uid} {
      allow read: if isOwner(uid) || isFriend(uid) || isAdmin();
      allow write: if (isOwner(uid) && isActivity(request.resource.data) && isActive(uid))
        || isAdmin();

      // Records et musiques partagés avec les amis, qui peuvent les « liker ».
      match /posts/{postId} {
        allow read: if isOwner(uid) || isFriend(uid) || isAdmin();
        allow create: if (isOwner(uid)
          && isShortString(request.resource.data.name, 120)
          && request.resource.data.likes is list
          && request.resource.data.likes.size() == 0
          && request.resource.data.at == request.time
          && (isPrPost(request.resource.data) || isMusicPost(request.resource.data))
          && isActive(uid))
          || isAdmin();
        // Liker / retirer son like : seul son propre uid, sans doublon.
        allow update: if (signedIn()
          && onlyChanges(['likes'])
          && request.resource.data.likes.size() == request.resource.data.likes.toSet().size()
          && request.resource.data.likes.toSet().difference(resource.data.likes.toSet()).hasOnly([request.auth.uid])
          && resource.data.likes.toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid])
          && (isOwner(uid) || isFriend(uid)))
          || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // Profil partagé avec les amis (page profil) : contenu choisi par son auteur.
    match /shared/{uid} {
      allow read: if isOwner(uid) || isFriend(uid) || isAdmin();
      allow write: if (isOwner(uid) && isSharedProfile(request.resource.data) && isActive(uid))
        || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Photo de profil (JPEG compressé), visible par les amis et l'admin.
    match /avatars/{uid} {
      allow read: if isOwner(uid) || isFriend(uid) || isAdmin();
      allow write: if (isOwner(uid)
        && request.resource.data.keys().hasOnly(['img', 'at'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 150000
        && request.resource.data.img.matches('^data:image/jpeg;base64,.*')
        && isActive(uid))
        || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Réglages de l'app : liens utiles publics (config/links) pour les connectés,
    // tout le reste (dont config/linksPrivate) réservé à l'admin.
    match /config/{docId} {
      allow read: if (docId == 'links' && signedIn()) || isAdmin();
      allow write: if isAdmin();
    }

    // Bibliothèque de programmes types : réservée à l'admin.
    match /library/{itemId} {
      allow read, write: if isAdmin();
    }
  }
}
